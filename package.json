{
  "name": "super-calendar",
  "version": "2.16.1",
  "private": true,
  "description": "Monorepo for super-calendar: a shared core with React Native, React DOM, and Solid renderers.",
  "homepage": "https://github.com/afonsojramos/super-calendar#readme",
  "bugs": {
    "url": "https://github.com/afonsojramos/super-calendar/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afonsojramos/super-calendar.git"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:demos": "node scripts/build-demos.mjs",
    "test:demos": "vitest run --config vitest.demos.config.mts",
    "typecheck": "tsc --noEmit && pnpm --filter @super-calendar/solid typecheck",
    "test": "vitest run",
    "test:parity": "node scripts/verify-web-test-parity.mjs",
    "test:browser": "node scripts/verify-web-test-parity.mjs --browser",
    "test:react18:browser": "vitest run --config vitest.react18.config.mts",
    "test:solid:browser": "node scripts/verify-solid.mjs",
    "test:solid:browser:dist": "node scripts/verify-solid.mjs --dist",
    "test:solid:package": "node scripts/verify-solid-package.mjs",
    "bench": "pnpm --filter @super-calendar/core bench",
    "bench:web": "vitest run --config vitest.performance.config.mts",
    "parity:visual": "node scripts/visual-parity.mjs",
    "lint": "oxlint --type-aware packages tests",
    "lint:fix": "oxlint --fix --type-aware packages tests",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "hooks:install": "hk install --mise",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@legendapp/list": "^3.7.1",
    "@react-native/babel-preset": "0.86.3",
    "@solidjs/babel-plugin": "2.0.0-rc.20",
    "@solidjs/web": "2.0.0-rc.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/babel__core": "7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "date-fns": "4.4.0",
    "jsdom": "26.1.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright": "1.64.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "solid-js": "2.0.0-rc.20",
    "test-renderer": "1.2.0",
    "ts-morph": "^28.0.0",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "vitest-native": "0.13.0"
  },
  "packageManager": "pnpm@12.4.1"
}
