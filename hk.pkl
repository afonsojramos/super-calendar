amends "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Config.pkl"

steps {
  ["format"] {
    check = "pnpm run format"
  }
  ["lint"] {
    check = "pnpm run lint"
    depends = "format"
  }
  ["typecheck"] {
    check = "pnpm run typecheck"
    depends = "lint"
  }
  ["test"] {
    check = "pnpm run test --runInBand"
    depends = "typecheck"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
  }
}
