{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vitest/globals", "vitest-native/rntl-matchers", "node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "noEmit": true,
    "paths": {
      "@super-calendar/core": ["./packages/core/src/index.ts"],
      "@super-calendar/native": ["./packages/native/src/index.tsx"],
      "@super-calendar/native/picker": ["./packages/native/src/picker.tsx"],
      "@super-calendar/dom": ["./packages/dom/src/index.ts"],
      "@super-calendar/core/vanilla": ["./packages/core/src/vanilla.ts"],
      "@calendar-test/renderer": ["./tests/web/adapters/react.tsx"],
      "@calendar-browser/adapter": ["./tests/web/browser/fixtures/react.ts"],
      "@calendar-browser/library": ["./packages/dom/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "tests/architecture",
    "tests/tooling",
    "tests/types",
    "tests/web/contracts",
    "tests/web/browser",
    "tests/demos",
    "tests/performance",
    "vitest.config.mts",
    "vitest.browser.config.mts",
    "vitest.react18.config.mts",
    "vitest.demos.config.mts",
    "vitest.performance.config.mts"
  ],
  "exclude": ["**/dist", "**/node_modules", "packages/solid"]
}
