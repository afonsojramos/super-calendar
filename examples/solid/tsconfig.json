{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@super-calendar/solid": ["../../packages/solid/src/index.ts"],
      "@super-calendar/core/vanilla": ["../../packages/core/src/vanilla.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
